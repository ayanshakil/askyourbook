# --- Provider -------------------------------------------------------------
# gemini (default) or openai. Set the matching API key.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (defaults depend on LLM_PROVIDER).
# EMBEDDING_DIM is required if EMBEDDING_MODEL is overridden.
# CHAT_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=3072

# --- Infrastructure -------------------------------------------------------
PORT=8080
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=askyourbook_gemini
# LOG_FORMAT=text          # text or json
# LOG_LEVEL=info           # debug, info, warn, error

# --- Ingestion ------------------------------------------------------------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# EMBED_WORKERS=4          # max concurrent embedding batches
# EMBED_BATCH_SIZE=32      # chunks per embedding call
# MAX_UPLOAD_MB=50

# --- Chat -----------------------------------------------------------------
# TOP_K_DEFAULT=4
# TOP_K_MAX=20
# SCORE_THRESHOLD=0        # 0 disables; Gemini scores are compressed, tune carefully
# REWRITE_QUERIES=true     # rewrite follow-ups into standalone search queries
# HISTORY_MESSAGES=10

# --- LLM retries (429 / 5xx) -----------------------------------------------
# LLM_MAX_RETRIES=4
# LLM_RETRY_BASE_DELAY=500ms
# LLM_RETRY_MAX_DELAY=10s
