# --- Provider -------------------------------------------------------------
# Set ONE of these keys; the provider is chosen from whichever is present.
# Write it as KEY=value, with no spaces around the "=".
#
#   Gemini: get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
#   (GEMINI_API_KEY works too.)
#
#   OpenAI: get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# If both keys are set, Gemini is used. To force one, uncomment:
# LLM_PROVIDER=openai      # gemini or openai
#
# Optional model overrides (defaults depend on the provider).
# EMBEDDING_DIM is required if EMBEDDING_MODEL is overridden.
# CHAT_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=3072

# --- Infrastructure -------------------------------------------------------
PORT=8080
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=askyourbook_gemini
# LOG_FORMAT=text          # text or json
# LOG_LEVEL=info           # debug, info, warn, error

# --- Ingestion ------------------------------------------------------------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# EMBED_WORKERS=4          # max concurrent embedding calls, across all uploads
# INGEST_WORKERS=2         # documents indexed concurrently in the background
# INGEST_QUEUE=16          # uploads that can wait; beyond this POST returns 503
# EMBED_BATCH_SIZE=32      # chunks per embedding call
# MAX_UPLOAD_MB=50
# MAX_CHUNKS=2000          # larger documents (about 800 pages) are rejected with 413

# --- Chat -----------------------------------------------------------------
# TOP_K_DEFAULT=4
# TOP_K_MAX=20
# Minimum cosine similarity for a hit; 0 disables. If nothing passes, the API
# answers "not found" without calling the LLM. Gemini scores are compressed:
# on the C++ guide, relevant questions scored 0.60-0.77 and unrelated ones
# 0.46-0.62, so 0.55 filters clearly off-topic questions without losing answers.
# SCORE_THRESHOLD=0
# REWRITE_QUERIES=true     # rewrite follow-ups into standalone search queries
# HISTORY_MESSAGES=10

# --- Chat sessions ----------------------------------------------------------
# memory (default; lost on restart) or redis (shared, survives restarts)
# SESSION_STORE=memory
# REDIS_URL=redis://localhost:6379/0
# If another Redis already listens on 6379 (e.g. Homebrew), start the compose
# one on another port: REDIS_PORT=6380 docker compose up -d redis
# and point REDIS_URL at redis://localhost:6380/0.
# SESSION_TTL=24h          # idle sessions are forgotten after this

# --- LLM retries (429 / 5xx) -----------------------------------------------
# LLM_MAX_RETRIES=4
# LLM_RETRY_BASE_DELAY=500ms
# LLM_RETRY_MAX_DELAY=10s
